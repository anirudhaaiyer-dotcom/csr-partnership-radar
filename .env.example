# Required in production
CRON_SECRET=            # Vercel sends this as Authorization: Bearer <value> to cron routes
APP_PASSWORD=           # protects every write action (Pursue, Not for us, Run now, Companies, Settings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
RESEND_API_KEY=
DIGEST_TO=              # Ananya's address
DIGEST_FROM=            # verified sender in Resend
APP_URL=                # public URL of the deployment, used in email links
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # server only, never exposed to the browser
